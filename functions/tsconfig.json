{
  "compilerOptions": {
    "module":          "commonjs",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals":  true,
    "outDir":          "lib",
    "sourceMap":       true,
    "strict":          true,
    "target":          "ES2022",
    "lib":             ["ES2022"],
    "esModuleInterop": true
  },
  "compileOnSave": true,
  "include": ["src"]
}
