# Frontend — Firebase web app config (safe to be public, these are web API keys)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Backend URL — Cloud Functions base URL
VITE_BACKEND_URL=https://us-central1-your-project-id.cloudfunctions.net/api

# Development only — set to "true" to use Firebase emulators locally
VITE_USE_EMULATORS=true

# ─────────────────────────────────────────────────────────
# Backend (functions/.env) — for local development ONLY
# In production, ALL secrets come from Google Cloud Secret Manager.
# The Gemini API key MUST NEVER be committed to source control.
# ─────────────────────────────────────────────────────────

# functions/.env (create this file, it is in .gitignore)
# GEMINI_API_KEY_DEV=your-gemini-api-key-for-local-dev-only
# FRONTEND_URL=http://localhost:5173
